<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D6EAF8">

    <!-- 1. Large Mascot in the background -->
    <ImageView
        android:id="@+id/mascotView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:contentDescription="Mascot"
        android:scaleType="fitCenter"
        android:src="@drawable/umika_urahime"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Suggestion chips (Top) -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 2. Name Tag -->
    <TextView
        android:id="@+id/tvMascotName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="Umika Urahime"
        android:textColor="#1A3A5C"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/chatBoxCard"
        app:layout_constraintStart_toStartOf="@+id/chatBoxCard"
        app:layout_constraintTop_toTopOf="@+id/chatBoxCard" />

    <androidx.cardview.widget.CardView
        android:id="@+id/chatBoxCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#CCFFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBundleCard"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintTop_toBottomOf="@id/chipsScroll"
        app:layout_constraintVertical_bias="1.0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />
    </androidx.cardview.widget.CardView>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/chatBoxCard"
        app:layout_constraintEnd_toEndOf="@id/chatBoxCard"
        app:layout_constraintStart_toStartOf="@id/chatBoxCard"
        app:layout_constraintTop_toTopOf="@id/chatBoxCard" />

    <!-- Placeholder text -->
    <TextView
        android:id="@+id/tvItineraryEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:gravity="center"
        android:padding="32dp"
        android:text="Welcome! I'm Umika Urahime. Your personal travel assistant. How may I help you today?."
        android:textColor="#1A3A5C"
        android:textSize="18sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="@id/chatBoxCard"
        app:layout_constraintEnd_toEndOf="@id/chatBoxCard"
        app:layout_constraintStart_toStartOf="@id/chatBoxCard"
        app:layout_constraintTop_toTopOf="@id/chatBoxCard" />

    <!-- View Plan Button (Appears when minimized) -->
    <Button
        android:id="@+id/btnShowPlan"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        android:backgroundTint="#1A3A5C"
        android:paddingHorizontal="12dp"
        android:text="View Plan"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipsScroll" />

    <!-- Itinerary section with Minimize Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/itineraryContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FDFEFE"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/tvMascotName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipsScroll"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="Travel Itinerary"
                    android:textColor="#1A3A5C"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnClearItinerary"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#1A3A5C" />

                    <ImageButton
                        android:id="@+id/btnMinimizeItinerary"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#1A3A5C" />
                </LinearLayout>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItinerary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. Input bar (Bottom) -->
    <LinearLayout
        android:id="@+id/bottomBundleCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/card_bg"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="none"
            android:background="@android:color/transparent"
            android:hint="Ask about Cebu spots or food..."
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:padding="12dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1A3A5C"
            android:text="Send"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>